# Build output directories
build*

# Logs and run outputs
logs/*
artifacts/*
ansible-configs/logs/*
ansible-configs/artifacts/*
ansible-configs/tests/
ansible-configs/backups/

# Generated deployment tree: certs (generate_keys.sh), voter lists (staged by
# bootstrap.sh from data/). Keep the scripts and each component's config.ini so
# a fresh clone can run `docker compose up` without ansible.
apps/docker-test-deployment/*
!apps/docker-test-deployment/generate_keys.sh
!apps/docker-test-deployment/delete_keys.sh
!apps/docker-test-deployment/bootstrap.sh

# A re-include cannot resurrect a file whose parent directory is excluded, so
# each component directory is unwound one level before its config.ini is kept.
!apps/docker-test-deployment/checkin_server/
apps/docker-test-deployment/checkin_server/*
!apps/docker-test-deployment/checkin_server/config.ini
!apps/docker-test-deployment/id_server/
apps/docker-test-deployment/id_server/*
!apps/docker-test-deployment/id_server/config.ini
!apps/docker-test-deployment/client0/
apps/docker-test-deployment/client0/*
!apps/docker-test-deployment/client0/config.ini
!apps/docker-test-deployment/client1/
apps/docker-test-deployment/client1/*
!apps/docker-test-deployment/client1/config.ini

# Stale/unreferenced PKI copies + root key-gen output
ansible-configs/ca/
ansible-configs/client*/
ansible-configs/checkin_server/
ansible-configs/id_server/
server0/
server1/

# Physical-device PKI generated by device-deployment. Keep only its instructions.
ansible-configs/device-deployment/secrets/*
!ansible-configs/device-deployment/secrets/shared/
ansible-configs/device-deployment/secrets/shared/*
!ansible-configs/device-deployment/secrets/shared/README.md

# Python
__pycache__/
*.pyc

# VS Code settings
.vscode

# random files
.watcher.lock
.clang-format
