services:
  # checkin builds image_name once; every other service reuses that image so
  # the stack performs a single docker build instead of one build per container.
  checkin:
    build: {{ checkin.build | default('.') }}
    image: {{ image_name | default('epollbook:latest') }}
    container_name: {{ checkin.container }}
    tty: true
    stdin_open: true
    working_dir: {{ checkin.workdir }}
    mem_limit: {{ container_mem_limit | default('8g') }}
    networks:
      pollbook:
        {% if network.checkin_host is defined %}ipv4_address: "{{ network.checkin_host }}"{% endif %}
    develop:
      watch:
        - path: .
          target: /epollbook
          action: sync

  dummy-id:
    image: {{ image_name | default('epollbook:latest') }}
    container_name: {{ id_server.container }}
    tty: true
    stdin_open: true
    working_dir: {{ id_server.workdir }}
    mem_limit: {{ container_mem_limit | default('8g') }}
    networks:
      pollbook:
        {% if network.id_host is defined %}ipv4_address: "{{ network.id_host }}"{% endif %}
    develop:
      watch:
        - path: .
          target: /epollbook
          action: sync

  {% for c in clients_generated %}
  {{ c.name }}:
    image: {{ image_name | default('epollbook:latest') }}
    container_name: {{ c.container }}
    tty: true
    stdin_open: true
    working_dir: {{ c.workdir }}
    mem_limit: {{ container_mem_limit | default('8g') }}
    networks:
      pollbook:
        ipv4_address: "{{ c.ip }}"
    environment:
      CLIENT_ID: "{{ c.id }}"
      TRUSTED: "{{ 1 if c.type == 'trusted' else 0 }}"
    develop:
      watch:
        - path: .
          target: /epollbook
          action: sync
  {% endfor %}

networks:
  pollbook:
    ipam:
      config:
        - subnet: "{{ network.subnet | default('172.16.0.0/16') }}"
          {% if network.gateway is defined %}gateway: "{{ network.gateway }}"{% endif %}

