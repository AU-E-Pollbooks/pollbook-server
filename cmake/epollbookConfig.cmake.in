@PACKAGE_INIT@

# Re-declare all dependencies declared in CMakeLists.txt so they are forwarded
# to downstream consumers of this package
include(CMakeFindDependencyMacro)
find_dependency(spdlog 1.3.1...1.9.2)
find_dependency(OpenSSL 1.1.1)
find_dependency(nlohmann_json 3.10.5)
find_dependency(mutils)

set_and_check(epollbook_INCLUDE_DIRS "@PACKAGE_CMAKE_INSTALL_INCLUDEDIR@")
set(epollbook_LIBRARIES "-L@PACKAGE_CMAKE_INSTALL_LIBDIR@ -lepollbook")
include("${CMAKE_CURRENT_LIST_DIR}/epollbookTargets.cmake")

check_required_components(epollbook)